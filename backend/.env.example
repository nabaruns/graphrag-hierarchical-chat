# --- LLM (OpenAI-compatible endpoint) ---
# Default: self-hosted Ollama inside docker-compose (no key, CPU friendly).
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5:3b-instruct

# To use OpenRouter instead, comment the above and set:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-your-key
# LLM_MODEL=openai/gpt-4o-mini

# To use self-hosted vLLM on k8s:
# OPENAI_BASE_URL=http://vllm-service:8000/v1
# OPENAI_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Embeddings (local, no key) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=child_chunks

# --- Retrieval tuning ---
TOP_K=5
MAX_HOPS=2
MAX_ITERATIONS=2

# --- Abuse protection (POST /chat and /ingest) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=2
# Cloudflare Turnstile: leave unset to disable verification.
# TURNSTILE_SECRET_KEY=0x4AAA...
